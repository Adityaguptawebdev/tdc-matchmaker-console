# ── Server ──────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
# Comma-separated list of allowed browser origins (the web app).
CORS_ORIGINS=http://localhost:5173
# Set to true behind a proxy/load balancer (Render) so rate limiting sees real client IPs.
TRUST_PROXY=false

# ── Data store ──────────────────────────────────────────────────────────
# auto   = MongoDB if reachable, otherwise the local JSON file store (logged loudly)
# mongo  = MongoDB only (fail fast)    file = JSON file only    memory = tests only, NOT persistent
DATA_STORE=auto
MONGODB_URI=mongodb://127.0.0.1:27017/tdc_matchmaker
FILE_DB_PATH=./data/db.json
# Seed demo data automatically when the database is empty.
AUTO_SEED=true

# ── Auth ────────────────────────────────────────────────────────────────
# Required in production (min 32 chars). Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
SESSION_TTL_HOURS=8
# Use COOKIE_SAMESITE=none (+ HTTPS) only if the web app and API are on different sites without a proxy.
COOKIE_SAMESITE=lax
# Defaults to true when NODE_ENV=production (HTTPS). Override only if you know why.
# COOKIE_SECURE=
# Show demo login credentials on the login page. Defaults to true in development; always off in production.
# SHOW_DEMO_CREDENTIALS=true

# ── AI (optional) ───────────────────────────────────────────────────────
# Leave empty to use deterministic explanations and introduction templates.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_MS=12000

# ── Matching ────────────────────────────────────────────────────────────
# Assignment-specific gender rules (weight profiles + male-customer relation defaults).
MATCHING_ASSIGNMENT_RULES=true
MATCHING_MIN_SCORE=50

# ── Email ───────────────────────────────────────────────────────────────
# Only the mock provider is implemented: messages are written to the outbox, never delivered.
EMAIL_PROVIDER=mock
